# Copy this file to .env and set an owner account before starting the server.
# Remove ADMIN_PASSWORD from .env after the account is created.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Optional when deploying behind a reverse proxy.
# APP_ORIGIN=https://your-domain.example
# HOST=0.0.0.0
# TRUST_PROXY=1
# NODE_ENV=production
